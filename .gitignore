# ---- Python (generated, project-local) ----
.venv/
__pycache__/
*.pyc
*.pyo

# ---- Tool caches (generated, session-local) ----
.cache/
.tools/

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
desktop.ini
*.log

# ---- Node tooling (session-local; game itself is zero-dependency) ----
node_modules/

# ---- Test artifacts (headless playtest driver screenshots) ----
tests/.out/

# ---- v1.9 frame evidence (T0): the PNGs are regenerated, large artifacts.
#      Keep the index README committed so the audit trail survives. ----
tests/frames/*.png
tests/frames/*.manifest.json
# v1.9 polish items capture their BEFORE/AFTER sets into per-item subdirs
# (e.g. tests/frames/after-J1/). Those are regenerated by the harness too, so
# the PNGs + manifests stay gitignored (the README index + commit message
# reference them). Ignore them recursively under tests/frames/.
tests/frames/**/*.png
tests/frames/**/*.manifest.json
